+def _booth_ids(memory: OnlineSpeakerMemory, booth_protos: dict[str, list[float]]) -> set[str]:
+    """Announcer crew: persisted booth + top live talkers."""
+    ids = set(booth_protos)
+    scored: list[tuple[float, int, str]] = []
+    for cluster in memory.clusters:
+        if cluster.cum_s < BOOTH_MIN_CUMULATIVE_S:
+            continue
+        if cluster.occurrence_count < BOOTH_MIN_OCCURRENCES:
+            continue
+        scored.append((cluster.cum_s, cluster.occurrence_count, cluster.cluster_id))
+    scored.sort(reverse=True)
+    for _, _, cid in scored[:BOOTH_TOP_N]:
+        ids.add(cid)
+    return ids
+
