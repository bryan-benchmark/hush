# Copy values into C:\OHushData\farm\notify.env (outside git) — never commit real keys.

# --- SendGrid
# FROM must be SendGrid-verified. Prefer a HUSH-branded address.
# bryan@benchmark.care as From makes Gmail/iOS show "Benchmark".
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=HUSH
SENDGRID_REPLY_TO=
# Where you receive alerts (personal inbox is fine):
HUSH_ALERT_EMAIL=

# --- Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
HUSH_ALERT_SMS=

# --- Behavior
# Page once per open fault; clear when audit no longer sees it.
HUSH_NOTIFY_ONCE=1
HUSH_NOTIFY_COOLDOWN_S=1800
HUSH_NOTIFY_INFO=0
# Audit: auto-close dead/finished takes; one Streamers recover before paging hung lives.
HUSH_AUDIT_AUTO_RECOVER=1
